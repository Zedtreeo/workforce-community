# ── Zedtreeo Workforce CE — example environment ──────────────────────────────
# Copy to .env and change EVERY secret before any real deployment.

# App
NODE_ENV=production
WEB_PORT=3000
API_PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Auth (CHANGE THIS — generate: openssl rand -base64 32)
BETTER_AUTH_SECRET=change-me-in-production
BETTER_AUTH_URL=http://localhost:4000

# Database (Postgres — provided by docker compose)
POSTGRES_USER=hrms
POSTGRES_PASSWORD=change-me
POSTGRES_DB=hrms
DATABASE_URL=postgresql://hrms:change-me@postgres:5432/hrms?schema=public

# Redis (provided by docker compose)
REDIS_URL=redis://redis:6379
REDIS_HOST=redis
REDIS_PORT=6379

# Object storage (MinIO — provided by docker compose)
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=change-me
S3_BUCKET=hrms

# Email — dev uses Mailpit (catches all mail at http://localhost:8025)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Zedtreeo Workforce <no-reply@example.com>

# Demo — seed synthetic data + accept a fixed OTP for admin@demo.local
# Set BOTH to false for a real deployment.
SEED_DEMO=true
DEMO_MODE=true
DEMO_OTP=123456
