model EmployeeExit {
  id                  String    @id @default(cuid())
  tenantId            String    @map("tenant_id")
  employeeId          String    @unique @map("employee_id")
  exitType            String    @default("RESIGNATION") // RESIGNATION | TERMINATION
  resignationDate     DateTime? @map("resignation_date") @db.Date
  lastWorkingDay      DateTime  @map("last_working_day") @db.Date
  reason              String?
  status              String    @default("INITIATED") // INITIATED | SETTLED | CANCELLED
  // Full-and-final (computed at settle)
  ctcMonthly          Decimal?  @map("ctc_monthly") @db.Decimal(12, 2)
  pendingSalaryDays   Decimal?  @map("pending_salary_days") @db.Decimal(6, 2)
  pendingSalaryAmount Decimal?  @map("pending_salary_amount") @db.Decimal(12, 2)
  adjustments         Json? // [{ label, amount }]  (+ credit / - recovery)
  netSettlement       Decimal?  @map("net_settlement") @db.Decimal(12, 2)
  settlementNotes     String?   @map("settlement_notes")
  settlementPdfPath   String?   @map("settlement_pdf_path")
  settledAt           DateTime? @map("settled_at")
  initiatedBy         String?   @map("initiated_by")
  settledBy           String?   @map("settled_by")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  @@index([tenantId, status])
  @@map("employee_exits")
}
