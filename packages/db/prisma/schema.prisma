generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// CORE MODELS — Tenant + User + Auth
// ============================================================

model Tenant {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  domain    String?   @unique
  logo      String?
  plan      Plan      @default(STARTER)
  currency  String    @default("INR")
  timezone  String    @default("Asia/Kolkata")
  gstNumber String?   @map("gst_number")
  panNumber String?   @map("pan_number")
  tanNumber String?   @map("tan_number")
  pfNumber  String?   @map("pf_number")
  esiNumber String?   @map("esi_number")
  website   String?
  phone     String?
  address   String?
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  users                      User[]
  employees                  Employee[]
  departments                Department[]
  clients                    Client[]
  attendance                 Attendance[]
  monthlyAttendanceOverrides MonthlyAttendanceOverride[]
  assignments                EmployeeAssignment[]
  invoices                   Invoice[]
  timeLogs                   TimeLog[]
  activitySnapshots          ActivitySnapshot[]
  leaveTypes                 LeaveType[]
  leaveBalances              LeaveBalance[]
  leaveRequests              LeaveRequest[]
  notifications              Notification[]
  salaryStructures           SalaryStructure[]
  payrollRuns                PayrollRun[]
  payslips                   Payslip[]
  documentCategories         DocumentCategory[]
  employeeDocuments          EmployeeDocument[]
  holidays                   Holiday[]
  shiftTypes                 ShiftType[]
  employeeShifts             EmployeeShift[]
  auditLogs                  AuditLog[]
  clientPortalUsers          ClientPortalUser[]
  payHeads                   PayHead[]
  payStructureTemplates      PayStructureTemplate[]
  payStructureAssignments    PayStructureAssignment[]
  itDeclarations             ItDeclaration[]
  profileChangeRequests      ProfileChangeRequest[]
  helpContents               HelpContent[]
  kbArticles                 KbArticle[]
  offerLetters               OfferLetter[]
  attendanceImportBatches    AttendanceImportBatch[]
  letterTemplates            LetterTemplate[]
  generatedLetters           GeneratedLetter[]
  letterSettings             TenantLetterSettings?
  invoiceSettings            TenantInvoiceSettings?
  billingEntities            BillingEntity[]
  invoiceEmailTemplates      InvoiceEmailTemplate[]

  invoicePayments InvoicePayment[]


  @@map("tenants")
}

model User {
  id              String    @id @default(cuid())
  tenantId        String    @map("tenant_id")
  email           String
  name            String
  emailVerified   Boolean   @default(false) @map("email_verified")
  image           String?
  avatarUrl       String?   @map("avatar_url")
  role            UserRole  @default(MEMBER)
  isActive        Boolean   @default(true) @map("is_active")
  // Per-user module restriction: null = follow access profile / role;
  // {"mode":"allow"|"deny","modules":["invoices","client-portal",...]}
  moduleScopes    Json?     @map("module_scopes")
  // Named access profile (role + module set); per-user moduleScopes overrides it
  accessProfileId String?   @map("access_profile_id")
  lastLoginAt     DateTime? @map("last_login_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  accessProfile AccessProfile? @relation(fields: [accessProfileId], references: [id], onDelete: SetNull)
  sessions      Session[]
  accounts      Account[]
  notifications Notification[]

  managedClients Client[] @relation("ClientAccountManager")

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([email])
  @@index([accessProfileId])
  @@map("users")
}

// Named access role: base UserRole + optional module scopes. Assigning a
// profile stamps its baseRole onto the user; scopes resolve live so editing
// a profile updates everyone on it.
model AccessProfile {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  name        String
  description String?
  baseRole    UserRole @default(MEMBER) @map("base_role")
  scopes      Json?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users User[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("access_profiles")
}

model Session {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String    @map("user_id")
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  idToken               String?   @map("id_token")
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("verifications")
}

// ============================================================
// HR MODELS — Employee + Department
// ============================================================

model Employee {
  id                 String            @id @default(cuid())
  tenantId           String            @map("tenant_id")
  employeeCode       String            @map("employee_code")
  firstName          String            @map("first_name")
  lastName           String            @map("last_name")
  email              String
  phone              String?
  designation        String?
  departmentId       String?           @map("department_id")
  joinDate           DateTime          @map("join_date")
  exitDate           DateTime?         @map("exit_date")
  status             EmployeeStatus    @default(ACTIVE)
  engagementType     EngagementType    @default(EMPLOYEE) @map("engagement_type")
  consultantTdsRate  Decimal           @default(2) @map("consultant_tds_rate") @db.Decimal(5, 2)
  taxRegime          TaxRegime         @default(NEW) @map("tax_regime")
  salary             Decimal           @db.Decimal(12, 2)
  pfNumber           String?           @map("pf_number")
  esiNumber          String?           @map("esi_number")
  panNumber          String?           @map("pan_number")
  bankAccount        String?           @map("bank_account")
  bankIfsc           String?           @map("bank_ifsc")
  bankName           String?           @map("bank_name")
  bankBranch         String?           @map("bank_branch")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")
  deletedAt          DateTime?         @map("deleted_at")
  createdBy          String?           @map("created_by")
  updatedBy          String?           @map("updated_by")
  onboardingStatus   OnboardingStatus? @map("onboarding_status")
  reportingManagerId String?           @map("reporting_manager_id")
  inviteToken        String?           @unique @map("invite_token")
  inviteExpiresAt    DateTime?         @map("invite_expires_at")
  offerAcceptedAt    DateTime?         @map("offer_accepted_at")
  accruedLeaveMonths Int               @default(0) @map("accrued_leave_months")

  tenant                     Tenant                      @relation(fields: [tenantId], references: [id])
  department                 Department?                 @relation(fields: [departmentId], references: [id])
  reportingManager           Employee?                   @relation("EmployeeReporting", fields: [reportingManagerId], references: [id])
  reports                    Employee[]                  @relation("EmployeeReporting")
  attendance                 Attendance[]
  monthlyAttendanceOverrides MonthlyAttendanceOverride[]
  assignments                EmployeeAssignment[]
  timeLogs                   TimeLog[]
  activitySnapshots          ActivitySnapshot[]
  leaveBalances              LeaveBalance[]
  leaveRequests              LeaveRequest[]
  salaryStructures           SalaryStructure[]
  payslips                   Payslip[]
  documents                  EmployeeDocument[]
  shifts                     EmployeeShift[]
  payStructureAssignments    PayStructureAssignment[]
  itDeclarations             ItDeclaration[]
  profileChangeRequests      ProfileChangeRequest[]
  offerLetter                OfferLetter?
  GeneratedLetter            GeneratedLetter[]

  approvalStatus EmployeeApprovalStatus @default(APPROVED) @map("approval_status")
  approvedBy     String?                @map("approved_by")
  approvedAt     DateTime?              @map("approved_at")
  rejectedAt     DateTime?              @map("rejected_at")
  rejectedReason String?                @map("rejected_reason")
  submittedAt    DateTime?              @map("submitted_at")

  @@unique([tenantId, employeeCode])
  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, departmentId])
  @@index([tenantId, deletedAt])
  @@map("employees")
}

model Department {
  id        String    @id @default(cuid())
  tenantId  String    @map("tenant_id")
  name      String
  code      String
  headId    String?   @map("head_id")
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  employees Employee[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, deletedAt])
  @@map("departments")
}

// ============================================================
// BILLING MODELS — Client (invoice + payment models come later)
// ============================================================

model Client {
  id                String    @id @default(cuid())
  tenantId          String    @map("tenant_id")
  name              String
  firstName         String?   @map("first_name") // primary contact first name
  lastName          String?   @map("last_name") // primary contact last name
  email             String
  country           String
  currency          String    @default("USD")
  billingEmail      String?   @map("billing_email")
  payoneerEmail     String?   @map("payoneer_email")
  website           String?   @map("website")
  registeredAddress String?   @map("registered_address")
  signatoryName     String?   @map("signatory_name")
  contactNumber     String?   @map("contact_number")
  portalEnabled     Boolean   @default(false) @map("portal_enabled") // client portal (email-OTP) access
  isActive          Boolean   @default(true) @map("is_active")
  // Which legal entity bills this client (null = tenant default entity)
  billingEntityId   String?   @map("billing_entity_id")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  tenant          Tenant               @relation(fields: [tenantId], references: [id])
  billingEntity   BillingEntity?       @relation(fields: [billingEntityId], references: [id], onDelete: SetNull)
  assignments     EmployeeAssignment[]
  invoices        Invoice[]
  portalUsers     ClientPortalUser[]
  GeneratedLetter GeneratedLetter[]

  accountManagerId String? @map("account_manager_id")
  accountManager   User?   @relation("ClientAccountManager", fields: [accountManagerId], references: [id])

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([tenantId, isActive])
  @@index([tenantId, deletedAt])
  @@map("clients")
}

// ============================================================
// EMPLOYEE ASSIGNMENT — Employee deployed to Client with billing rate
// ============================================================

model EmployeeAssignment {
  id                 String           @id @default(cuid())
  tenantId           String           @map("tenant_id")
  employeeId         String           @map("employee_id")
  clientId           String           @map("client_id")
  role               String? // Client-facing role (may differ from employee.designation)
  startDate          DateTime         @map("start_date")
  endDate            DateTime?        @map("end_date")
  billingRate        Decimal          @map("billing_rate") @db.Decimal(12, 2)
  currency           String           @default("USD")
  billingCycle       BillingCycle     @default(MONTHLY) @map("billing_cycle")
  workSchedule       WorkSchedule     @default(FULL_TIME) @map("work_schedule")
  status             AssignmentStatus @default(ACTIVE)
  notes              String?
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")
  createdBy          String?          @map("created_by")
  updatedBy          String?          @map("updated_by")
  accruedLeaveMonths Int              @default(0) @map("accrued_leave_months")

  tenant          Tenant            @relation(fields: [tenantId], references: [id])
  employee        Employee          @relation(fields: [employeeId], references: [id])
  client          Client            @relation(fields: [clientId], references: [id])
  lineItems       InvoiceLineItem[]
  GeneratedLetter GeneratedLetter[]

  @@index([tenantId])
  @@index([tenantId, employeeId])
  @@index([tenantId, clientId])
  @@index([tenantId, status])
  @@map("employee_assignments")
}

// ============================================================
// INVOICE MODELS — Invoice + Line Items
// ============================================================

model Invoice {
  id            String        @id @default(cuid())
  tenantId      String        @map("tenant_id")
  clientId      String        @map("client_id")
  invoiceNumber String        @map("invoice_number") // e.g. INV-2026-0001
  invoiceDate   DateTime      @map("invoice_date") @db.Date
  dueDate       DateTime      @map("due_date") @db.Date
  periodStart   DateTime      @map("period_start") @db.Date
  periodEnd     DateTime      @map("period_end") @db.Date
  subtotal      Decimal       @db.Decimal(14, 2)
  taxPercent    Decimal       @default(0) @map("tax_percent") @db.Decimal(5, 2)
  taxAmount     Decimal       @default(0) @map("tax_amount") @db.Decimal(14, 2)
  total         Decimal       @db.Decimal(14, 2)
  currency      String        @default("USD")
  status        InvoiceStatus @default(DRAFT)
  notes         String?
  paymentTerms  String?       @map("payment_terms") // e.g. "Net 30"
  payoneerLink  String?       @map("payoneer_link") // per-invoice Payoneer payment URL (shown in email)
  paidAt        DateTime?     @map("paid_at")
  paidAmount    Decimal?      @map("paid_amount") @db.Decimal(14, 2)
  paymentRef    String?       @map("payment_ref") // Payoneer transaction ID
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  createdBy     String?       @map("created_by")
  updatedBy     String?       @map("updated_by")

  // Which legal entity issues this invoice (null = tenant default entity)
  billingEntityId String? @map("billing_entity_id")

  tenant        Tenant            @relation(fields: [tenantId], references: [id])
  client        Client            @relation(fields: [clientId], references: [id])
  billingEntity BillingEntity?    @relation(fields: [billingEntityId], references: [id], onDelete: SetNull)
  lineItems     InvoiceLineItem[]

  amountWrittenOff Decimal?         @default(0) @map("amount_written_off") @db.Decimal(14, 2)
  writeOffReason   String?          @map("write_off_reason")
  sentAt           DateTime?        @map("sent_at")
  sentTo           String?          @map("sent_to")
  payments         InvoicePayment[]

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId])
  @@index([tenantId, clientId])
  @@index([tenantId, status])
  @@index([tenantId, dueDate])
  @@index([billingEntityId])
  @@map("invoices")
}

// A legal entity that issues invoices (e.g. "LegelpTech Outsourcing Pvt Ltd"
// vs "Legelp Services LLP"). Each has its own name, address, payment
// instructions and invoice-number series (invoicePrefix).
model BillingEntity {
  id                  String   @id @default(cuid())
  tenantId            String   @map("tenant_id")
  name                String
  registeredAddress   String?  @map("registered_address")
  taxLine             String?  @map("tax_line") // optional free-text tax id line
  paymentInstructions String?  @map("payment_instructions")
  invoicePrefix       String   @map("invoice_prefix") // e.g. "LEGELP/ZT"; series = {prefix}/{FY}/{seq}
  isDefault           Boolean  @default(false) @map("is_default")
  isActive            Boolean  @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  invoices Invoice[]
  clients  Client[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("billing_entities")
}

model InvoiceLineItem {
  id           String   @id @default(cuid())
  invoiceId    String   @map("invoice_id")
  assignmentId String?  @map("assignment_id") // links to the assignment
  description  String // e.g. "Ravi Kumar — Senior Backend Engineer (Apr 2026)"
  quantity     Decimal  @db.Decimal(10, 2) // hours or 1 for monthly
  rate         Decimal  @db.Decimal(12, 2) // billing rate
  amount       Decimal  @db.Decimal(14, 2) // quantity * rate
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")

  invoice    Invoice             @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  assignment EmployeeAssignment? @relation(fields: [assignmentId], references: [id])

  @@index([invoiceId])
  @@map("invoice_line_items")
}

// ============================================================
// REMOTE MONITORING — Time Logs + Activity Snapshots
// ============================================================

model TimeLog {
  id         String        @id @default(cuid())
  tenantId   String        @map("tenant_id")
  employeeId String        @map("employee_id")
  date       DateTime      @db.Date
  clockIn    DateTime      @map("clock_in")
  clockOut   DateTime?     @map("clock_out")
  duration   Int? // total seconds worked
  source     TimeLogSource @default(MANUAL)
  notes      String?
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([tenantId, date])
  @@index([tenantId, employeeId])
  @@index([tenantId, employeeId, date])
  @@map("time_logs")
}

model ActivitySnapshot {
  id              String   @id @default(cuid())
  tenantId        String   @map("tenant_id")
  employeeId      String   @map("employee_id")
  capturedAt      DateTime @map("captured_at")
  screenshotUrl   String?  @map("screenshot_url") // S3/R2 URL (or local path for now)
  thumbnailUrl    String?  @map("thumbnail_url")
  activityPercent Int      @default(0) @map("activity_percent") // 0-100
  keystrokes      Int      @default(0)
  mouseClicks     Int      @default(0)
  mouseMovements  Int      @default(0) @map("mouse_movements")
  activeApp       String?  @map("active_app") // e.g. "VS Code"
  activeUrl       String?  @map("active_url") // browser URL if applicable
  activeTitle     String?  @map("active_title") // window title
  isIdle          Boolean  @default(false) @map("is_idle")
  createdAt       DateTime @default(now()) @map("created_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([tenantId, employeeId, capturedAt])
  @@index([tenantId, capturedAt])
  @@map("activity_snapshots")
}

// ============================================================
// LEAVE MANAGEMENT — Types, Balances, Requests
// ============================================================

model LeaveType {
  id           String   @id @default(cuid())
  tenantId     String   @map("tenant_id")
  name         String // e.g. "Casual Leave", "Sick Leave", "Earned Leave"
  code         String // e.g. "CL", "SL", "EL"
  isPaid       Boolean  @default(true) @map("is_paid")
  defaultDays  Int      @default(12) @map("default_days") // annual quota
  carryForward Boolean  @default(false) @map("carry_forward")
  maxCarryDays Int      @default(0) @map("max_carry_days")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant   Tenant         @relation(fields: [tenantId], references: [id])
  balances LeaveBalance[]
  requests LeaveRequest[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("leave_types")
}

model LeaveBalance {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  employeeId  String   @map("employee_id")
  leaveTypeId String   @map("leave_type_id")
  year        Int // e.g. 2026
  entitled    Decimal  @default(0) @db.Decimal(6, 2) // total days entitled
  used        Decimal  @default(0) @db.Decimal(6, 2) // days used
  carriedOver Decimal  @default(0) @map("carried_over") @db.Decimal(6, 2)
  adjustment  Decimal  @default(0) @db.Decimal(6, 2) // manual adjustments (+/-)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  employee  Employee  @relation(fields: [employeeId], references: [id])
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@unique([tenantId, employeeId, leaveTypeId, year])
  @@index([tenantId, employeeId])
  @@index([tenantId, year])
  @@map("leave_balances")
}

model LeaveRequest {
  id          String      @id @default(cuid())
  tenantId    String      @map("tenant_id")
  employeeId  String      @map("employee_id")
  leaveTypeId String      @map("leave_type_id")
  startDate   DateTime    @map("start_date") @db.Date
  endDate     DateTime    @map("end_date") @db.Date
  days        Decimal     @db.Decimal(4, 1) // supports half-days: 0.5, 1.0, 2.5 etc.
  reason      String?
  status      LeaveStatus @default(PENDING)
  reviewedBy  String?     @map("reviewed_by") // userId who approved/rejected
  reviewedAt  DateTime?   @map("reviewed_at")
  reviewNote  String?     @map("review_note")
  cancelledAt DateTime?   @map("cancelled_at")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  employee  Employee  @relation(fields: [employeeId], references: [id])
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@index([tenantId, employeeId])
  @@index([tenantId, status])
  @@index([tenantId, startDate])
  @@map("leave_requests")
}

// ============================================================
// PAYROLL — Salary Structures, Payroll Runs, Payslips
// ============================================================

model SalaryStructure {
  id            String    @id @default(cuid())
  tenantId      String    @map("tenant_id")
  employeeId    String    @map("employee_id")
  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date

  // Earnings
  basic        Decimal @db.Decimal(12, 2) // Basic salary
  hra          Decimal @default(0) @db.Decimal(12, 2) // House Rent Allowance
  da           Decimal @default(0) @db.Decimal(12, 2) // Dearness Allowance
  specialAllow Decimal @default(0) @map("special_allow") @db.Decimal(12, 2)
  otherAllow   Decimal @default(0) @map("other_allow") @db.Decimal(12, 2)
  grossSalary  Decimal @map("gross_salary") @db.Decimal(12, 2)

  // Deductions (employer/employee contributions)
  pfEmployee  Decimal @default(0) @map("pf_employee") @db.Decimal(12, 2) // 12% of basic
  pfEmployer  Decimal @default(0) @map("pf_employer") @db.Decimal(12, 2) // 12% of basic
  esiEmployee Decimal @default(0) @map("esi_employee") @db.Decimal(12, 2) // 0.75% of gross
  esiEmployer Decimal @default(0) @map("esi_employer") @db.Decimal(12, 2) // 3.25% of gross
  profTax     Decimal @default(0) @map("prof_tax") @db.Decimal(12, 2) // Professional Tax (state)
  tds         Decimal @default(0) @db.Decimal(12, 2) // Monthly TDS estimate

  netSalary Decimal @map("net_salary") @db.Decimal(12, 2)
  ctc       Decimal @db.Decimal(12, 2) // Annual CTC

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([tenantId, employeeId])
  @@index([tenantId, isActive])
  @@map("salary_structures")
}

model PayrollRun {
  id                  String        @id @default(cuid())
  tenantId            String        @map("tenant_id")
  month               Int // 1-12
  year                Int
  runDate             DateTime      @map("run_date")
  status              PayrollStatus @default(DRAFT)
  totalGross          Decimal       @default(0) @map("total_gross") @db.Decimal(14, 2)
  totalDeductions     Decimal       @default(0) @map("total_deductions") @db.Decimal(14, 2)
  totalNet            Decimal       @default(0) @map("total_net") @db.Decimal(14, 2)
  employeeCount       Int           @default(0) @map("employee_count")
  processedBy         String?       @map("processed_by")
  approvedBy          String?       @map("approved_by")
  approvedAt          DateTime?     @map("approved_at")
  frozenAt            DateTime?     @map("frozen_at")
  frozenBy            String?       @map("frozen_by")
  finalizedAt         DateTime?     @map("finalized_at")
  finalizedBy         String?       @map("finalized_by")
  bankFileUrl         String?       @map("bank_file_url")
  bankFileGeneratedAt DateTime?     @map("bank_file_generated_at")
  notes               String?
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  payslips Payslip[]

  @@unique([tenantId, month, year])
  @@index([tenantId])
  @@map("payroll_runs")
}

model Payslip {
  id           String @id @default(cuid())
  tenantId     String @map("tenant_id")
  payrollRunId String @map("payroll_run_id")
  employeeId   String @map("employee_id")
  month        Int
  year         Int

  // Earnings
  basic         Decimal @db.Decimal(12, 2)
  hra           Decimal @default(0) @db.Decimal(12, 2)
  da            Decimal @default(0) @db.Decimal(12, 2)
  specialAllow  Decimal @default(0) @map("special_allow") @db.Decimal(12, 2)
  otherAllow    Decimal @default(0) @map("other_allow") @db.Decimal(12, 2)
  grossEarnings Decimal @map("gross_earnings") @db.Decimal(12, 2)

  // Deductions
  pfEmployee      Decimal @default(0) @map("pf_employee") @db.Decimal(12, 2)
  esiEmployee     Decimal @default(0) @map("esi_employee") @db.Decimal(12, 2)
  profTax         Decimal @default(0) @map("prof_tax") @db.Decimal(12, 2)
  tds             Decimal @default(0) @db.Decimal(12, 2)
  otherDeductions Decimal @default(0) @map("other_deductions") @db.Decimal(12, 2)
  totalDeductions Decimal @map("total_deductions") @db.Decimal(12, 2)

  // Net
  netPay Decimal @map("net_pay") @db.Decimal(12, 2)

  // Ad-hoc per-payslip head adjustments (NOT pay structure): [{type:EARNING|DEDUCTION,label,amount}]
  adjustments Json @default("[]")

  // TDS computation breakdown snapshot (JSON)
  tdsBreakdown Json? @map("tds_breakdown")

  // LOP (Loss of Pay)
  workingDays Int @default(0) @map("working_days")
  paidDays    Int @default(0) @map("paid_days")
  lopDays     Int @default(0) @map("lop_days")

  paidAt     DateTime? @map("paid_at")
  paymentRef String?   @map("payment_ref")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  tenant     Tenant        @relation(fields: [tenantId], references: [id])
  payrollRun PayrollRun    @relation(fields: [payrollRunId], references: [id])
  employee   Employee      @relation(fields: [employeeId], references: [id])
  lines      PayslipLine[]

  @@unique([tenantId, employeeId, month, year])
  @@index([tenantId, payrollRunId])
  @@index([tenantId, employeeId])
  @@map("payslips")
}

