// ============================================================
// CONFIGURABLE PAY STRUCTURES — Formula-based Payroll Engine
// ============================================================

// Individual pay component definition (e.g., "Basic+DA", "HRA", "PF")
model PayHead {
  id          String          @id @default(cuid())
  tenantId    String          @map("tenant_id")
  name        String // Display name: "Basic and DA"
  code        String // Short code: "BASIC_DA"
  type        PayHeadType // EARNING or DEDUCTION
  category    PayHeadCategory @default(FIXED) // FIXED, VARIABLE, STATUTORY
  description String?

  // Statutory flags
  isStatutory   Boolean        @default(false) @map("is_statutory")
  statutoryType StatutoryType? @map("statutory_type") // PF, ESI, PT, GRATUITY, TDS

  // Display
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant       Tenant                  @relation(fields: [tenantId], references: [id])
  components   PayStructureComponent[]
  payslipLines PayslipLine[]

  @@unique([tenantId, code])
  @@index([tenantId, type])
  @@map("pay_heads")
}

// Named pay structure template (e.g., "Standard CTC", "5 Days Working")
model PayStructureTemplate {
  id            String    @id @default(cuid())
  tenantId      String    @map("tenant_id")
  name          String // "Standard CTC 50:25:25"
  description   String?
  effectiveFrom DateTime? @map("effective_from") @db.Date
  isDefault     Boolean   @default(false) @map("is_default")
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  tenant      Tenant                   @relation(fields: [tenantId], references: [id])
  components  PayStructureComponent[]
  assignments PayStructureAssignment[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("pay_structure_templates")
}

// Links a PayHead to a PayStructureTemplate with formula + flags
model PayStructureComponent {
  id         String @id @default(cuid())
  templateId String @map("template_id")
  headId     String @map("head_id")

  // Formula (e.g., "MIN((BASIC_DA % 50), ((MGROSS / TDC * PDC) - BASIC_DA))")
  formula        String? // null = manual entry
  formulaDisplay String? @map("formula_display") // Human-readable version

  // Flags (matching the screenshot Y/N columns)
  isVariable    Boolean @default(false) @map("is_variable") // Manual input each month
  showOnPayslip Boolean @default(true) @map("show_on_payslip")
  hasArrear     Boolean @default(false) @map("has_arrear")
  hasIncrPct    Boolean @default(false) @map("has_incr_pct") // Increment percentage

  // Statutory computation flags
  affectsPf       Boolean @default(false) @map("affects_pf")
  affectsEsi      Boolean @default(false) @map("affects_esi")
  affectsPt       Boolean @default(false) @map("affects_pt")
  affectsGratuity Boolean @default(false) @map("affects_gratuity")

  // Rounding
  roundingMode      RoundingMode @default(NORMAL) @map("rounding_mode")
  roundingPrecision Int          @default(0) @map("rounding_precision") // decimal places

  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  template PayStructureTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  head     PayHead              @relation(fields: [headId], references: [id])

  @@unique([templateId, headId])
  @@index([templateId])
  @@map("pay_structure_components")
}

// Assigns a pay structure template to an employee
model PayStructureAssignment {
  id            String    @id @default(cuid())
  tenantId      String    @map("tenant_id")
  employeeId    String    @map("employee_id")
  templateId    String    @map("template_id")
  ctcAnnual     Decimal?  @map("ctc_annual") @db.Decimal(14, 2) // Annual CTC
  ctcMonthly    Decimal?  @map("ctc_monthly") @db.Decimal(12, 2) // Monthly gross (MGross)
  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  tenant   Tenant               @relation(fields: [tenantId], references: [id])
  employee Employee             @relation(fields: [employeeId], references: [id])
  template PayStructureTemplate @relation(fields: [templateId], references: [id])

  @@index([tenantId, employeeId])
  @@index([tenantId, isActive])
  @@map("pay_structure_assignments")
}

// Individual calculated line item on a payslip
model PayslipLine {
  id        String      @id @default(cuid())
  payslipId String      @map("payslip_id")
  headId    String      @map("head_id")
  headName  String      @map("head_name") // Snapshot at time of calculation
  headType  PayHeadType @map("head_type") // EARNING or DEDUCTION

  rate         Decimal @default(0) @db.Decimal(12, 2) // Base rate
  amount       Decimal @db.Decimal(12, 2) // Calculated amount
  arrearAmount Decimal @default(0) @map("arrear_amount") @db.Decimal(12, 2)
  totalAmount  Decimal @map("total_amount") @db.Decimal(12, 2) // amount + arrear

  formula       String? // Formula used (for audit trail)
  sortOrder     Int      @default(0) @map("sort_order")
  showOnPayslip Boolean  @default(true) @map("show_on_payslip")
  createdAt     DateTime @default(now()) @map("created_at")

  payslip Payslip @relation(fields: [payslipId], references: [id], onDelete: Cascade)
  head    PayHead @relation(fields: [headId], references: [id])

  @@index([payslipId])
  @@map("payslip_lines")
}

// ============================================================
// ENUMS
// ============================================================

enum PayHeadType {
  EARNING
  DEDUCTION
}

enum PayHeadCategory {
  FIXED // Calculated from formula every month
  VARIABLE // Manually entered each month (Incentive, Bonus)
  STATUTORY // Auto-calculated (PF, ESI, PT)
}

enum StatutoryType {
  PF // Provident Fund (12% of Basic, ceiling 15000)
  ESI // Employee State Insurance (0.75% employee, 3.25% employer)
  PT // Professional Tax (state-based slab)
  GRATUITY // Gratuity (4.81% of Basic)
  TDS // Tax Deducted at Source
}

enum RoundingMode {
  NORMAL // Standard rounding
  FLOOR // Round down
  CEILING // Round up
  NONE // No rounding
}

enum Plan {
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

