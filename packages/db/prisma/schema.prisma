  category    KbCategory @default(GUIDE)
  tags        String[]   @default([])
  isPublished Boolean    @default(false) @map("is_published")
  viewCount   Int        @default(0) @map("view_count")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  deletedAt   DateTime?  @map("deleted_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, slug])
  @@index([tenantId, module])
  @@index([tenantId, category])
  @@map("kb_articles")
}

enum KbCategory {
  GUIDE
  FAQ
  POLICY
  COMPLIANCE
  TROUBLESHOOTING
}

enum OnboardingStatus {
  INVITED
  OFFER_PENDING
  DETAILS_PENDING
  DOCUMENTS_PENDING
  COMPLETED
}

enum ProfileChangeStatus {
  PENDING
  APPROVED
  REJECTED
}

model ProfileChangeRequest {
  id            String              @id @default(cuid())
  tenantId      String              @map("tenant_id")
  employeeId    String              @map("employee_id")
  requestedBy   String              @map("requested_by")
  changes       Json // { field: { old: value, new: value } }
  status        ProfileChangeStatus @default(PENDING)
  reviewedBy    String?             @map("reviewed_by")
  reviewedAt    DateTime?           @map("reviewed_at")
  reviewComment String?             @map("review_comment")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, employeeId])
  @@map("profile_change_requests")
}

model OfferLetter {
  id              String            @id @default(cuid())
  tenantId        String            @map("tenant_id")
  employeeId      String            @unique @map("employee_id")
  designation     String
  department      String?
  salary          Decimal           @db.Decimal(12, 2)
  joiningDate     DateTime          @map("joining_date")
  probationMonths Int               @default(6) @map("probation_months")
  workLocation    String?           @map("work_location")
  reportingTo     String?           @map("reporting_to")
  workSchedule    String?           @map("work_schedule") // e.g. "Mon-Fri, 9AM-6PM"
  employmentType  WorkSchedule      @default(FULL_TIME) @map("employment_type") // Full Time / Part Time
  benefits        String? // free-text benefits description
  terms           String?           @db.Text // additional terms & conditions
  status          OfferLetterStatus @default(SENT)
  acceptedAt      DateTime?         @map("accepted_at")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([tenantId])
  @@map("offer_letters")
}

enum OfferLetterStatus {
  SENT
  ACCEPTED
  REJECTED
}

model LetterTemplate {
  id          String     @id @default(cuid())
  tenantId    String     @map("tenant_id")
  type        LetterType
  name        String
  description String?
  filePath    String     @map("file_path")
  variables   Json       @default("[]")
  isDefault   Boolean    @default(false) @map("is_default")
  isActive    Boolean    @default(true) @map("is_active")
  version     Int        @default(1)
  createdBy   String?    @map("created_by")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  tenant    Tenant            @relation(fields: [tenantId], references: [id])
  generated GeneratedLetter[]

  @@index([tenantId, type, isActive])
  @@map("letter_templates")
}

model GeneratedLetter {
  id             String       @id @default(cuid())
  tenantId       String       @map("tenant_id")
  templateId     String       @map("template_id")
  type           LetterType
  employeeId     String?      @map("employee_id")
  clientId       String?      @map("client_id")
  assignmentId   String?      @map("assignment_id")
  referenceNo    String?      @map("reference_no")
  fileName       String       @map("file_name")
  filePath       String       @map("file_path")
  pdfPath        String?      @map("pdf_path")
  variables      Json
  status         LetterStatus @default(DRAFT)
  generatedBy    String       @map("generated_by")
  generatedAt    DateTime     @default(now()) @map("generated_at")
  sentAt         DateTime?    @map("sent_at")
  sentTo         String?      @map("sent_to")
  acceptedAt     DateTime?    @map("accepted_at")
  signedFilePath String?      @map("signed_file_path")
  notes          String?

  tenant     Tenant              @relation(fields: [tenantId], references: [id])
  template   LetterTemplate      @relation(fields: [templateId], references: [id])
  employee   Employee?           @relation(fields: [employeeId], references: [id])
  client     Client?             @relation(fields: [clientId], references: [id])
  assignment EmployeeAssignment? @relation(fields: [assignmentId], references: [id])

  @@index([tenantId, type, generatedAt])
  @@index([tenantId, employeeId])
  @@index([tenantId, clientId])
  @@index([tenantId, referenceNo])
  @@map("generated_letters")
}

model TenantLetterSettings {
  tenantId             String   @id @map("tenant_id")
  defaultWorkingHours  String   @default("9 hours/day, 6 days/week") @map("default_working_hours")
  defaultProbationDays Int      @default(90) @map("default_probation_days")
  defaultLocation      String   @default("New Delhi") @map("default_location")
  signatoryName        String?  @map("signatory_name")
  signatoryTitle       String?  @map("signatory_title")
  refNumberPrefix      String   @default("LEGELP/ZT") @map("ref_number_prefix")
  employeeCodePrefix   String   @default("LE") @map("employee_code_prefix") // auto employee-code prefix → LE1178
  counters             Json     @default("{}")
  updatedAt            DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("tenant_letter_settings")
}

model TenantInvoiceSettings {
  tenantId            String   @id @map("tenant_id")
  emailSubject        String?  @map("email_subject") // legacy single template (superseded by InvoiceEmailTemplate)
  emailBody           String?  @map("email_body") // legacy
  // Free-text block printed under "Payment Instructions" on the invoice PDF
  paymentInstructions String?  @map("payment_instructions")
  updatedAt           DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("tenant_invoice_settings")
}

// A named, reusable invoice email template. Body is PLAIN TEXT (with
// {{variables}}) — converted to formatted HTML at send time, so admins never
// have to write HTML.
model InvoiceEmailTemplate {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  name      String
  subject   String
  body      String // plain text, supports {{variables}}
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("invoice_email_templates")
}

enum LetterType {
  OFFER_LETTER
  APPOINTMENT_LETTER
  EXPERIENCE_LETTER
  CLIENT_AGREEMENT
}

enum LetterStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  VOIDED
}

model InvoicePayment {
  id                      String        @id @default(cuid())
  tenantId                String        @map("tenant_id")
  invoiceId               String        @map("invoice_id")
  paidOn                  DateTime      @map("paid_on") @db.Date
  amount                  Decimal       @db.Decimal(14, 2)
  currency                String // may differ from invoice currency
  exchangeRate            Decimal?      @map("exchange_rate") @db.Decimal(10, 6)
  amountInInvoiceCurrency Decimal       @map("amount_in_invoice_currency") @db.Decimal(14, 2)
  method                  PaymentMethod
  reference               String?
  bankFee                 Decimal?      @map("bank_fee") @db.Decimal(10, 2)
  notes                   String?
  recordedBy              String        @map("recorded_by")
  createdAt               DateTime      @default(now()) @map("created_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([tenantId, invoiceId])
  @@index([tenantId, paidOn])
  @@map("invoice_payments")
}

enum PaymentMethod {
  BANK_TRANSFER
  PAYONEER
  WIRE
  CREDIT_CARD
  CHECK
  CASH
  OTHER
}

model MonthlyAttendanceOverride {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  employeeId  String   @map("employee_id")
  year        Int
  month       Int
  workingDays Decimal  @default(0) @map("working_days") @db.Decimal(5, 2)
  timeoff     Decimal  @default(0) @db.Decimal(5, 2)
  overTime    Decimal  @default(0) @map("over_time") @db.Decimal(6, 2)
  lateCount   Int      @default(0) @map("late_count")
  earlyCount  Int      @default(0) @map("early_count")
  source      String   @default("UPLOAD")
  uploadedBy  String?  @map("uploaded_by")
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([tenantId, employeeId, year, month])
  @@index([tenantId, year, month])
  @@map("monthly_attendance_overrides")
}

model TaxSlab {
  id            String    @id @default(cuid())
  tenantId      String    @map("tenant_id")
  regime        TaxRegime
  financialYear String    @map("financial_year")
  fromAmount    Decimal   @map("from_amount") @db.Decimal(12, 2)
  toAmount      Decimal?  @map("to_amount") @db.Decimal(12, 2)
  ratePct       Decimal   @map("rate_pct") @db.Decimal(5, 2)
  sortOrder     Int       @default(0) @map("sort_order")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([tenantId, regime, financialYear])
  @@map("tax_slabs")
}

model TaxRegimeConfig {
  id                String    @id @default(cuid())
  tenantId          String    @map("tenant_id")
  regime            TaxRegime
  financialYear     String    @map("financial_year")
  standardDeduction Decimal   @default(0) @map("standard_deduction") @db.Decimal(12, 2)
  rebateMaxTaxable  Decimal   @default(0) @map("rebate_max_taxable") @db.Decimal(12, 2)
  cessPct           Decimal   @default(4) @map("cess_pct") @db.Decimal(5, 2)
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@unique([tenantId, regime, financialYear])
  @@map("tax_regime_configs")
}

model ItDeclaration {
  id               String              @id @default(cuid())
  tenantId         String              @map("tenant_id")
  employeeId       String              @map("employee_id")
  financialYear    String              @map("financial_year")
  regime           TaxRegime           @default(OLD)
  status           ItDeclarationStatus @default(DRAFT)
  sec80C           Decimal             @default(0) @map("sec_80c") @db.Decimal(12, 2)
  sec80CCD1B       Decimal             @default(0) @map("sec_80ccd1b") @db.Decimal(12, 2)
  sec80D           Decimal             @default(0) @map("sec_80d") @db.Decimal(12, 2)
  sec80E           Decimal             @default(0) @map("sec_80e") @db.Decimal(12, 2)
  sec80G           Decimal             @default(0) @map("sec_80g") @db.Decimal(12, 2)
  sec80TTA         Decimal             @default(0) @map("sec_80tta") @db.Decimal(12, 2)
  homeLoanInterest Decimal             @default(0) @map("home_loan_interest") @db.Decimal(12, 2)
  hraRentPaid      Decimal             @default(0) @map("hra_rent_paid") @db.Decimal(12, 2)
  metroCity        Boolean             @default(false) @map("metro_city")
  otherDeductions  Decimal             @default(0) @map("other_deductions") @db.Decimal(12, 2)
  submittedAt      DateTime?           @map("submitted_at")
  reviewedBy       String?             @map("reviewed_by")
  reviewedAt       DateTime?           @map("reviewed_at")
  remarks          String?
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  employee Employee @relation(fields: [employeeId], references: [id])
  Tenant   Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, employeeId, financialYear])
  @@index([tenantId, status])
  @@map("it_declarations")
}

